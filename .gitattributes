# Everything in this repo is downloaded into every site that installs the addon
# unless it is export-ignored. Tests, CI config and the listing artwork are not
# the buyer's problem.
#
# Never add /config, /resources/lang, /resources/views, /routes, /src, README.md,
# UPGRADE.md, CHANGELOG.md or LICENSE to this list — the published views are a
# documented override surface and the translations are half the front end.

/.github            export-ignore
/tests              export-ignore
/art                export-ignore
/screenshots        export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml        export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json    export-ignore
