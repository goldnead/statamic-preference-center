{
    "name": "goldnead/statamic-preference-center",
    "description": "One page for everything a person receives — mailing lists, product notifications, cadence and the blocks that override all three — assembled from whichever of the three sources is installed.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "preferences",
        "consent",
        "unsubscribe",
        "magic-link"
    ],
    "authors": [
        {
            "name": "Adrian Goldner",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-preference-center/issues",
        "source": "https://github.com/goldnead/statamic-preference-center"
    },
    "require": {
        "php": "^8.2",
        "goldnead/statamic-brand-context": "^1.4|^1.5",
        "goldnead/statamic-identity-contracts": "^1.0",
        "laravel/framework": "^12.40|^13.0",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "goldnead/statamic-leadhub": "^1.10",
        "goldnead/statamic-marketing": "^1.8.1",
        "goldnead/statamic-notifications": "^1.1",
        "goldnead/statamic-suppression": "^1.0",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "goldnead/statamic-marketing": "Adds the mailing-list block, and with it the token door this package's preference links use.",
        "goldnead/statamic-notifications": "Adds the product-notification matrix and the cadence block.",
        "goldnead/statamic-suppression": "Adds the block state. Without it nothing is reported as blocked — install it before you trust the page.",
        "goldnead/statamic-leadhub": "Lets a magic link and a session resolve to a contact, and records the audit trail on the contact timeline."
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\PreferenceCenter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\PreferenceCenter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "slug": "preference-center",
            "name": "Preference Center",
            "description": "One page for lists, product notifications, cadence and blocks.",
            "url": "https://github.com/goldnead/statamic-preference-center",
            "developer": "Adrian Goldner",
            "developer-url": "https://gldnr.studio"
        },
        "laravel": {
            "providers": [
                "Goldnead\\PreferenceCenter\\ServiceProvider"
            ],
            "aliases": {
                "PreferenceCenter": "Goldnead\\PreferenceCenter\\Facades\\PreferenceCenter"
            }
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true
        },
        "preferred-install": {
            "goldnead/*": "source"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
